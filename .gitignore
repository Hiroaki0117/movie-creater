# --- 依存関係 ---
node_modules/

# --- HyperFrames の生成物 ---
# 注: `*.mp4` のような全体除外は書かない。デッキに動画素材を置いた瞬間、
#     コミットから静かに漏れて Vercel 上だけ壊れる。出力先ディレクトリだけ除外する。
out/
renders/
.media/
.hyperframes-cache/
# 検証用に撮り直せるので追跡しない（配信に使うポスターは media/ に置く）
snapshots/

